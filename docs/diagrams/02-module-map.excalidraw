      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 60,
      "y": 11508,
      "strokeColor": "#0e7490",
      "backgroundColor": "transparent",
      "width": 1030,
