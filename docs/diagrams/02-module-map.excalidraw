   "type": "text",
   "version": 1,
   "versionNonce": 1455684712,
   "isDeleted": false,
   "id": "asbuilt-20260819d-p2-recipe-compilation",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "x": 60,
   "y": 21187.5,
   "strokeColor": "#0e7490",
   "backgroundColor": "transparent",
   "width": 1010.0,
