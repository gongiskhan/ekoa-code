      "isDeleted": false,
      "id": "asbuilt-20260820-s1-action-evidence",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 60,
      "y": 26200,
      "strokeColor": "#0e7490",
      "backgroundColor": "transparent",
      "width": 1060,
      "height": 805.0,
      "seed": 202608201,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": null,
      "updated": 1755700000000,
