      "type": "text",
      "id": "correction-20260820e-a-rung-cannot-throw-an-answer-away",
      "containerId": null,
      "x": 60.0,
      "y": 31290.0,
      "width": 1060,
      "height": 997.5,
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#b45309",
