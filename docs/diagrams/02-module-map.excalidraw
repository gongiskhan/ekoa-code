    {
      "type": "text",
      "version": 1,
      "versionNonce": 771204411,
      "isDeleted": false,
      "id": "asbuilt-20260805-workspace-credential",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 60,
      "y": 12228,
      "strokeColor": "#0e7490",
      "backgroundColor": "transparent",
      "width": 1030,
      "height": 595,
      "seed": 481920733,
      "groupIds": [],
      "frameId": null,
