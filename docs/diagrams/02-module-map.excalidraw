    {
      "type": "text",
      "id": "asbuilt-20260820-s4s5-reuse-ladder",
      "containerId": null,
      "x": 60,
      "y": 26340,
      "width": 1060,
      "height": 1155.0,
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#0e7490",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 202608201,
      "version": 1,
      "versionNonce": 202608202,
      "isDeleted": false,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
