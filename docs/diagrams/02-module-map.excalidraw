      "type": "text",
      "version": 1,
      "versionNonce": 913772551,
      "isDeleted": false,
      "id": "asbuilt-20260819e-p2-compilation-soundness",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "x": 60,
      "y": 22165.0,
      "strokeColor": "#0e7490",
      "backgroundColor": "transparent",
      "width": 1010.0,
      "height": 822.5,
      "seed": 512338664,
      "groupIds": [],
