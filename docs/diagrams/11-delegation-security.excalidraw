    {
      "type": "text",
      "id": "annot-p1-cortex-seam-20260819",
      "x": 1000,
      "y": 2200,
      "width": 900.0,
      "height": 507.5,
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#9d174d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
