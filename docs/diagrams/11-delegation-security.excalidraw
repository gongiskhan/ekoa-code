    {
      "type": "text",
      "id": "annot-s-inject-20260824",
      "x": 60,
      "y": 10600,
      "width": 1180.0,
      "height": 1590.0,
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#7c3aed",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 202608241,
      "version": 1,
      "versionNonce": 202608242,
