      "id": "annot-run-lease-20260819",
      "x": 60,
      "y": 3000,
      "width": 848.4,
      "height": 1225.0,
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#9d174d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 618442907,
      "version": 2,
      "versionNonce": 771204331,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
