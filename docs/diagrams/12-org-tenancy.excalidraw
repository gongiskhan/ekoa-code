    {
      "type": "text",
      "id": "asbuilt-20260820j-s6-queue-runs-the-floor",
      "containerId": null,
      "x": 60,
      "y": 2280,
      "width": 831.6,
      "height": 700.0,
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#b91c1c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 733911499,
      "version": 1,
      "versionNonce": 481204977,
      "isDeleted": false,
