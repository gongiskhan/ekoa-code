    {
      "type": "text",
      "id": "asbuilt-20260820-s6-review-queue-tenancy",
      "containerId": null,
      "x": 60,
      "y": 1694,
      "width": 831.6,
      "height": 542.5,
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#0e7490",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 733911411,
