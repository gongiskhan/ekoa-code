      "opacity": 100,
      "angle": 0,
      "x": 60,
      "y": 5160,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "width": 940,
      "height": 620,
      "seed": 660100201,
      "groupIds": [],
