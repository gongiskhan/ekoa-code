      "isDeleted": false,
      "id": "asbuilt-20260803-e2-publish-snapshot",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 60,
      "y": 7275,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "width": 980,
      "height": 676,
      "seed": 812340001,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
